#. Author URI of the plugin/theme
msgid "http://madpixels.net"
msgstr "http://madpixels.net"

#. Author of the plugin/theme
msgid "Madpixels"
msgstr "Madpixels"

#. Description of the plugin/theme
msgid "A simple, easy to use and quite powerful tool to create, manage and embed interactive charts into your WordPress posts and pages. The plugin uses Google Visualization API to render charts, which supports cross-browser compatibility (adopting VML for older IE versions) and cross-platform portability to iOS and new Android releases."
msgstr "Простой, легкий в использовании и довольно мощный инструмент для создания, управления и встраивания интерактивных диаграмм в ваши записи и на страницы WordPress. Плагин использует Google Visualization API для визуализации диаграмм, который совместим с различными браузерами (использует VML для более старых версий IE), а также с iOS и новыми версиями Android."

#. Plugin URI of the plugin/theme
msgid "https://github.com/madpixelslabs/visualizer"
msgstr "https://github.com/madpixelslabs/visualizer"

#. Plugin Name of the plugin/theme
msgid "WordPress Visualizer"
msgstr "WordPress Visualizer"

#: classes/Visualizer/Render/Templates.php:70
msgid "Insert"
msgstr "Вставить"

#: classes/Visualizer/Render/Sidebar.php:541
msgid "Enter custom format pattern to apply to this series value, similar to the %sICU date and time format%s."
msgstr "Создайте собственный шаблон формата для различных повторяющихся значений, подобно %sформату даты и времени ICU%s."

#: classes/Visualizer/Render/Sidebar.php:538
msgid "Date Format"
msgstr "Формат даты"

#: classes/Visualizer/Render/Sidebar.php:530
msgid "Enter custom format pattern to apply to this series value, similar to the %sICU pattern set%s. Use something like #,### to get 1,234 as output, or $# to add dollar sign before digits. Pay attention that if you use #%% percentage format then your values will be multiplied by 100."
msgstr "Создайте собственный шаблон формата для различных повторяющихся значений, подобно %sформату даты и времени ICU%s. Например, используйте #,### чтобы получить 1,234 на выходе или $# для вставки символа доллара перед цифрами. Обратите внимание, если Вы используете #%% в качестве процентного формата, то значения будут умножены на 100."

#: classes/Visualizer/Render/Sidebar.php:414
msgid "Hex Value"
msgstr "Цвет в шестнадцатиричном коде (HEX)"

#: classes/Visualizer/Render/Sidebar.php:363
msgid "Determines the width and hight of the chart area."
msgstr "Определяет ширину и высоту области диаграммы."

#: classes/Visualizer/Render/Sidebar.php:349
msgid "Width And Height Of Chart Area"
msgstr "Ширина и высота области диаграммы"

#: classes/Visualizer/Render/Sidebar.php:343
msgid "Determines how far to draw the chart from the left and top borders."
msgstr "Определяет отступ диаграммы от левой и верхней границ."

#: classes/Visualizer/Render/Sidebar.php:329
msgid "Left And Top Margins"
msgstr "Левый и верхний отступы"

#: classes/Visualizer/Render/Sidebar.php:325
msgid "Configure the placement and size of the chart area (where the chart itself is drawn, excluding axis and legends). Two formats are supported: a number, or a number followed by %. A simple number is a value in pixels; a number followed by % is a percentage."
msgstr "Настройте положение и размер диаграммы (исключая ось и легенды) Поддерживаются два формата: числовой и число, оканчивающееся символом %. Это будут значения в пикселях и в процентах, соответственно."

#: classes/Visualizer/Render/Sidebar.php:324
msgid "Chart Area"
msgstr "Диаграмма с областями"

#: classes/Visualizer/Render/Sidebar.php:319
msgid "Transparent background"
msgstr "Прозрачный фон"

#: classes/Visualizer/Render/Sidebar.php:266
msgid "Layout"
msgstr "Разметка"

#: classes/Visualizer/Render/Sidebar.php:253
msgid "If set to yes, will show colored squares next to the slice information in the tooltip."
msgstr "Если да, во всплывающей подсказке с информацией будут цветовые метки."

#: classes/Visualizer/Render/Sidebar.php:249
msgid "Show Color Code"
msgstr "Показать код цвета"

#: classes/Visualizer/Render/Sidebar.php:242
msgid "The tooltip will be displayed when the user selects an element"
msgstr "Подсказка будет выведена, когда пользователь выберет элемент"

#: classes/Visualizer/Render/Sidebar.php:214
msgid "Font Color"
msgstr "Цвет шрифта"

#: classes/Visualizer/Render/Sidebar.php:210
msgid "Determines the alignment of the legend."
msgstr "Определяет выравнивание легенды."

#: classes/Visualizer/Render/Sidebar.php:206
msgid "Alignment"
msgstr "Выравнивание"

#: classes/Visualizer/Render/Sidebar.php:202
msgid "Determines where to place the legend, compared to the chart area."
msgstr "Определяет, куда поместить легенду относительно диаграммы."

#: classes/Visualizer/Render/Sidebar.php:198
msgid "Position"
msgstr "Позиция"

#: classes/Visualizer/Render/Sidebar.php:196
msgid "Legend"
msgstr "Легенда"

#: classes/Visualizer/Render/Sidebar.php:191
msgid "The default font family and size for all text in the chart."
msgstr "Название шрифта и размер по умолчанию для всех надписей в диаграмме."

#: classes/Visualizer/Render/Sidebar.php:165
msgid "Family And Size"
msgstr "Семейство и размер"

#: classes/Visualizer/Render/Sidebar.php:162
msgid "Font Styles"
msgstr "Стили шрифта"

#: classes/Visualizer/Render/Sidebar.php:158
msgid "Title"
msgstr "Заголовок"

#: classes/Visualizer/Render/Sidebar.php:155
msgid "Configure title, font styles, tooltip, legend and else settings for the chart."
msgstr "Настройте заголовок, стили шрифта, всплывающие подсказки, легенду и другие настройки для диаграммы."

#: classes/Visualizer/Render/Sidebar.php:112
msgid "Aligned to the end of the allocated area"
msgstr "Выравнивание по концу выделенной области"

#: classes/Visualizer/Render/Sidebar.php:111
msgid "Centered in the allocated area"
msgstr "По центру выделенной области"

#: classes/Visualizer/Render/Sidebar.php:110
msgid "Aligned to the start of the allocated area"
msgstr "Выравнивается по началу выделенного области"

#: classes/Visualizer/Render/Sidebar.php:105
msgid "Omit the legend"
msgstr "Опустить легенду"

#: classes/Visualizer/Render/Sidebar.php:103
msgid "Below the chart"
msgstr "Ниже диаграммы"

#: classes/Visualizer/Render/Sidebar.php:102
msgid "Above the chart"
msgstr "Над диаграммой"

#: classes/Visualizer/Render/Sidebar.php:101
msgid "Right of the chart"
msgstr "Справа от диаграммы"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:202
msgid "Determines what information to display when the user hovers over a pie slice."
msgstr "Определяет, какая информация будет выведена, когда пользователь наведёт указатель на сегмент."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:200
msgid "Display only the percentage of the whole represented by the slice"
msgstr "Отображать только процент от общего значения"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:199
msgid "Display only the absolute value of the slice"
msgstr "Отображать только абсолютное значение сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:198
msgid "Display both the absolute value of the slice and the percentage of the whole"
msgstr "Отображать абсолютное и процентное значение сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:193
msgid "Text"
msgstr "Текст"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:172
msgid "Slice Color"
msgstr "Цвет сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:167
msgid "How far to separate the slice from the rest of the pie, from 0.0 (not at all) to 1.0 (the pie's radius)."
msgstr "Как далеко отодвинуть сегмент от остальной диаграммы, от 0.0 (не отодвигать) до 1.0 (на радиус диаграммы)."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:164
msgid "Slice Offset"
msgstr "Смещение сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:160
msgid "Slices Settings"
msgstr "Настройки сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:143
msgid "Residue Slice Color"
msgstr "Цвет остаточного сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:139
msgid "Other"
msgstr "Другие"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:138
msgid "A label for the combination slice that holds all slices below slice visibility threshold."
msgstr "Метка для комбинированного сегмента, который содержит все сегменты ниже порога видимости сегмента."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:135
msgid "Residue Slice Label"
msgstr "Метка остаточного сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:130
msgid "The slice relative part, below which a slice will not show individually. All slices that have not passed this threshold will be combined to a single slice, whose size is the sum of all their sizes. Default is not to show individually any slice which is smaller than half a degree."
msgstr "Относительный порог видимости, ниже которого сегмент не будет виден отдельно. Все сегменты, не прошедшие порог будут объединены в общий сегмент, размер которого будет составлять сумму всех таких сегментов. По умолчанию группируются сегменты, которые занимают меньше половины градуса."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:127
msgid "Visibility Threshold"
msgstr "Порог видимости"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:124
msgid "Residue Settings"
msgstr "Остальные настройки"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:107
msgid "Slice Border Color"
msgstr "Цвет границы сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:102
msgid "The angle, in degrees, to rotate the chart by. The default of 0 will orient the leftmost edge of the first slice directly up."
msgstr "Угол поворота диаграммы в процентах. По умолчанию 0, левый край первого сегмента будет ориентирован строго вверх."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:99
msgid "Start Angle"
msgstr "Начальный угол"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:94
msgid "If between 0 and 1, displays a donut chart. The hole with have a radius equal to number times the radius of the chart. Only applicable when the chart is two-dimensional."
msgstr "Отображает кольцевую диаграмму, если значение от 0 до 1. Радиус отверстия кратен радиусу диаграммы. Применяется только тогда, когда диаграмма двумерная."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:91
msgid "Pie Hole"
msgstr "Отверстие диаграммы"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:87
msgid "The content of the text displayed on the slice."
msgstr "Содержимое текста, отображаемого на сегменте."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:85
msgid "No text is displayed"
msgstr "Текст не отображается"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:84
msgid "The name of the slice"
msgstr "Название сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:83
msgid "The quantitative value of the slice"
msgstr "Количественное значение сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:82
msgid "The percentage of the slice size out of the total"
msgstr "Процентный размер сегмента от общего"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:77
msgid "Slice Text"
msgstr "Тест сегмента"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:73
msgid "If set to yes, will draw slices counterclockwise."
msgstr "Если да, то прорисовка будет против часовой стрелки."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:69
msgid "Reverse Categories"
msgstr "Обратные (reverse) рубрики"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:65
msgid "If set to yes, displays a three-dimensional chart."
msgstr "Если да, то отобразит трёхмерную диаграмму."

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:61
msgid "Is 3D"
msgstr "Это 3D"

#: classes/Visualizer/Render/Sidebar/Type/Pie.php:58
msgid "Pie Settings"
msgstr "Настройки диаграммы"

#: classes/Visualizer/Render/Sidebar/Type/Line.php:67
msgid "Whether to guess the value of missing points. If yes, it will guess the value of any missing data based on neighboring points. If no, it will leave a break in the line at the unknown point."
msgstr "Нужно ли заполнять пропущенные точки. Если да, то пропущенные точки будут рассчитываться по соседним. Если нет, то в этих точках будет разрыв линии."

#: classes/Visualizer/Render/Sidebar/Type/Line.php:63
msgid "Interpolate Nulls"
msgstr "Интерполировать нули"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:377
#: classes/Visualizer/Render/Sidebar.php:310
msgid "Background Color"
msgstr "Цвет фона"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:365
#: classes/Visualizer/Render/Sidebar.php:297
msgid "The chart border width in pixels."
msgstr "Ширина границы диаграммы в пикселях."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:359
#: classes/Visualizer/Render/Sidebar.php:291
msgid "Configure the background color for the main area of the chart and the chart border width and color."
msgstr "Настройте цвет фона для основной области диаграммы, а также ширину и цвет границы диаграммы."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:354
msgid "If no, the map will be stretched to the exact size of the chart as specified by the width and height options."
msgstr "Если нет, то карта будет растянута до ширины и высоты, указанной в настройках."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:353
msgid "If yes, the map will be drawn at the largest size that can fit inside the chart area at its natural aspect ratio. If only one of the width and height options is specified, the other one will be calculated according to the aspect ratio."
msgstr "Если да, карта будет нарисована с максимальным размером, который может поместиться внутри области диаграммы с ее естественным соотношением сторон. Если указан только один из вариантов ширины и высоты, другой будет рассчитан в соответствии с соотношением сторон."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:349
msgid "Keep Aspect Ratio"
msgstr "Сохранить соотношение сторон"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:324
msgid "Layout Settings"
msgstr "Настройки разметки"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:309
msgid "The zoom factor of the magnifying glass. Can be any number greater than 0."
msgstr "Коэффициент масштабирования лупы. Может быть любым числом больше 0."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:306
msgid "Zoom Factor"
msgstr "Коэффициент увеличения"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:302
msgid "If yes, when the user lingers over a cluttered marker, a magnifiying glass will be opened."
msgstr "Если да, то когда пользователь задержится над загроможденным маркером, будет открываться лупа."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:298
msgid "Enabled"
msgstr "Включено"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:295
msgid "Configure magnifying glass settings, which appears, when the user lingers over a cluttered marker. Note: this feature is not supported in browsers that do not support SVG, i.e. Internet Explorer version 8 or earlier."
msgstr "Настройка параметров лупы, которое появляется, когда пользователь задержится на загромождённом участке. Примечание: эта функция не поддерживается в браузерах, которые не поддерживают SVG, т.е. Internet Explorer версии 8 или более ранней."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:293
msgid "Magnifying Glass"
msgstr "Лупа"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:275
msgid "The opacity of the markers, where 0.0 is fully transparent and 1.0 is fully opaque."
msgstr "Прозрачность маркеров, где 0.0 - это полностью прозрачные, а 1.0 - непрозрачные."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:272
msgid "Marker Opacity"
msgstr "Прозрачность маркера"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:267
msgid "Determines the radius of the smallest and largest possible bubbles, in pixels."
msgstr "Определяет наименьший и наибольший радиус пузырьков, в пикселях."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:253
msgid "Minimum And Maximum Marker Radius"
msgstr "Мин. и макс. радиус маркера"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:247
msgid "Determines the minimum and maximum values of size axis."
msgstr "Определяет мин. и макс. значение на оси."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:229
msgid "Configure how values are associated with bubble size, minimum and maximun values and marker opacity setting."
msgstr "Настройте, как значения связаны с размером пузырька, мин. и мак. значение, а также прозрачность маркера."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:227
msgid "Size Axis"
msgstr "Размер оси"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:209
msgid "Dateless Region"
msgstr "Регион без данных"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:195
msgid "Intermediate Value"
msgstr "Промежуточное значение"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:183
msgid "Determines the minimum and maximum values of color axis."
msgstr "Определяет мин. и макс. значение цветовой оси."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:169
#: classes/Visualizer/Render/Sidebar/Type/Geo.php:233
msgid "Minimum And Maximum Values"
msgstr "Мин. и макс. значения"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:165
msgid "Configure color axis gradient scale, minimum and maximun values and a color of the dateless regions."
msgstr "Настройте шкалу градиента цветовой оси, мин. и макс. значения и цвет областей без даты."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:163
msgid "Color Axis"
msgstr "Цветовая ось"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:151
#: classes/Visualizer/Render/Sidebar.php:245
msgid "Determines the user interaction that causes the tooltip to be displayed."
msgstr "Определяет взаимодействие с пользователем, которое вызывает всплывающую подсказку."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:149
#: classes/Visualizer/Render/Sidebar.php:243
msgid "The tooltip will not be displayed"
msgstr "Подсказка не отображается"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:148
#: classes/Visualizer/Render/Sidebar.php:241
msgid "The tooltip will be displayed when the user hovers over an element"
msgstr "Всплывающая подсказка не отображается, когда пользователь наводит указатель на элемент"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:143
#: classes/Visualizer/Render/Sidebar.php:236
msgid "Trigger"
msgstr "Триггер"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:128
#: classes/Visualizer/Render/Sidebar.php:221
msgid "Tooltip"
msgstr "Подсказка"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:123
msgid "Markers"
msgstr "Маркеры"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:122
msgid "Regions"
msgstr "Регионы"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:121
msgid "Auto"
msgstr "Авто"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:111
msgid "'markers' - This is a marker map."
msgstr "'маркеры' - это карта маркеров."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:110
msgid "'regions' - This is a region map."
msgstr "'регионы' - это карта региона."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:109
msgid "'auto' - Choose based on the format of the data."
msgstr "'авто' - выбор на основе формата данных."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:107
msgid "Determines which type of map this is. The following values are supported:"
msgstr "Определяет, какой это тип карты. Поддерживаются следующие значения:"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:104
#: classes/Visualizer/Render/Sidebar/Type/Geo.php:116
msgid "Display Mode"
msgstr "Режим отображения"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:98
msgid "Metros"
msgstr "Метро"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:97
msgid "Provinces"
msgstr "Провинции"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:96
msgid "Countries"
msgstr "Страны"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:86
msgid "'metros' - Supported for the US country region and US state regions only."
msgstr "'метро' - поддерживается только для США и регионов США ."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:85
msgid "'provinces' - Supported only for country regions and US state regions. Not supported for all countries; please test a country to see whether this option is supported."
msgstr "'провинции' - поддерживается только для близлежащих стран и штатов США. Не поддерживается для всех стран; пожалуйста, выберите страну, чтобы увидеть, поддерживается ли эта опция."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:84
msgid "'countries' - Supported for all regions, except for US state regions."
msgstr "\"страны\" - поддерживается для всех регионов, кроме регионов штатов США."

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:82
msgid "The resolution of the map borders. Choose one of the following values:"
msgstr "Разрешение для границ карты. Выберите одно из следующих значений:"

#: classes/Visualizer/Render/Sidebar/Type/Geo.php:79
